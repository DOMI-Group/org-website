---
const currentYear = new Date().getFullYear();

const sitemapLinks = [
  { name: 'Home', href: '#' },
  { name: 'Expertise', href: '#expertise' },
  { name: 'Stack', href: '#stack' },
  { name: 'Collective', href: '#collective' },
];

const contactLinks = [
  { label: 'General', email: 'contact@domi.or.id' },
  { label: 'Support', email: 'support@domi.or.id' },
  { label: 'Partners', email: 'partners@domi.or.id' },
];
---

<footer class="border-t border-border bg-surface/50">
  <div class="max-w-7xl mx-auto">
    <div class="py-12 md:py-16 px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <div class="lg:col-span-1">
        <span class="font-mono font-bold text-xl text-primary mb-4 block">DOMI GROUP</span>
        <p class="text-secondary text-sm leading-relaxed max-w-xs">
          Empowering sovereign infrastructure through open collaboration and shared engineering knowledge.
        </p>
      </div>
      <div>
        <h3 class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Sitemap</h3>
        <ul class="flex flex-col gap-3">
          {sitemapLinks.map((link) => (
            <li>
              <a href={link.href} class="text-secondary text-sm hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Contact</h3>
        <ul class="flex flex-col gap-3">
          {contactLinks.map((contact) => (
            <li>
              <span class="font-mono text-xs text-muted block mb-0.5">{contact.label}</span>
              <a href={`mailto:${contact.email}`} class="text-secondary text-sm hover:text-accent transition-colors">
                {contact.email}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-mono text-xs text-muted uppercase tracking-widest mb-4">Connect</h3>
        <a
          href="https://github.com/DOMI-Group"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-secondary hover:text-primary transition-colors text-sm"
        >
          GitHub Organization
          <span>→</span>
        </a>
      </div>
    </div>
    <div class="border-t border-border py-6 px-6">
      <div class="flex justify-between items-center flex-col sm:flex-row gap-4">
        <span class="font-mono text-xs text-muted">© {currentYear} DOMI Group. Built for the community.</span>
        <span class="font-mono text-xs text-muted/60">domi.or.id</span>
      </div>
    </div>
  </div>
</footer>
